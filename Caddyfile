:80 {
    root * /srv
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=(), accelerometer=(), autoplay=(), encrypted-media=(), gyroscope=(), magnetometer=(), midi=(), payment=(), usb=(), sync-xhr=()"
        X-Permitted-Cross-Domain-Policies "none"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self' data:; img-src 'self' data: https://images.unsplash.com; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; manifest-src 'self'; require-trusted-types-for 'script'; trusted-types brew-template 'allow-duplicates'"
        # Note: Strict-Transport-Security, Cross-Origin-Opener-Policy, Cross-Origin-Resource-Policy
        # are emitted by the HOST Caddy proxy layer via dokku caddy:labels:add to avoid header doubling.
        -Server
    }
    handle /health {
        header Content-Type application/json
        respond "{\"status\":\"ok\",\"version\":\"0.7.0\"}" 200
    }
    handle /healthz {
        header Content-Type application/json
        respond "{\"status\":\"ok\",\"version\":\"0.7.0\"}" 200
    }
    handle /version {
        header Content-Type application/json
        respond `{"app":"brew","version":"0.7.0","classification":"marketing/public/active"}` 200
    }
    @manifest path *.webmanifest
    header @manifest Content-Type "application/manifest+json; charset=utf-8"
    @static path_regexp static \.((jpg|jpeg|png|gif|svg|ico|css|js|woff2?|ttf|webmanifest))$
    header @static Cache-Control "public, immutable"
    handle {
        header Cache-Control "no-cache, must-revalidate"
        try_files {path} {path}/ =404
        file_server
    }
    handle_errors {
        @notfound expression {err.status_code} == 404
        rewrite @notfound /404.html
        file_server
    }
}
